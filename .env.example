# ---------------------------------------------------------------------------
# Team Ops System — environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored and never read from source.
# ---------------------------------------------------------------------------

# HTTP server.
#
# HOST=127.0.0.1  this machine only (default, safest)
# HOST=0.0.0.0    every network interface, so other machines on your LAN can
#                 reach it at http://<this-machine-ip>:4000
#
# Binding to 0.0.0.0 puts the whole system behind nothing but AUTH_PASSCODE.
# Only do it on a network you trust, and change the passcode below.
PORT=4000
HOST=0.0.0.0

# SQLite database file (relative paths resolve from the project root)
DATABASE_PATH=./data/team-ops.db

# Which dataset `npm run seed` loads when no --dataset flag is given.
#   AUTO_DOCK  real project data imported from the team daily task log
#   DEMO       synthetic sample data for development and tests
# Demo and real data are never mixed: one dataset is loaded per database.
SEED_DATASET=AUTO_DOCK

# Signing in uses each person's OWN passcode, stored as a scrypt hash on their
# user row — a manager sets one when adding them and can reset it. The seeds
# print the demo ones.
#
# This code only authorises BOOTSTRAPPING the first manager on an empty system.
# Still NOT production authentication — see README "Known Limitations".
AUTH_JOIN_CODE=demo1234

# Session lifetime in hours
SESSION_TTL_HOURS=12

# --- Exception rule thresholds (reused later by the automation engine) ---
# A task is DUE SOON when its due date is within this many calendar days.
DUE_SOON_DAYS=2
# A task is NO RECENT UPDATE after this many working days without an update.
NO_UPDATE_WORKING_DAYS=2
# An in-progress task is MISSING DAILY UPDATE after this many working days with
# no daily outcome logged. 1 means skipping a whole working day is chased.
DAILY_UPDATE_WORKING_DAYS=1

# Largest effort budget, in WORKING days, a single task may carry. The manager
# budgets the effort; the owner proposes dates that spend at most this much.
MAX_TASK_EFFORT_DAYS=5

# --- Build timeline ---
# The build timeline is written in relative weeks (W1..W14). This is the
# calendar date project week W1 starts from; it is snapped to that week's
# Monday. Change it and re-run `npm run seed:reset` to re-anchor every date
# in the plan. Unset, it defaults to the current week.
AUTODOCK_W1_START=2026-10-05

# --- Integrations (Layer 2+). All disabled in Layer 1. ---
INTEGRATION_DRIVE_ENABLED=false
INTEGRATION_GITHUB_ENABLED=false
INTEGRATION_CALENDAR_ENABLED=false
NOTIFICATIONS_ENABLED=false

# --- TLS -------------------------------------------------------------------
# Both set, the server speaks HTTPS and nothing crosses the network readable.
# `npm run tls:selfsigned` writes a certificate valid for this machine's
# addresses; browsers warn once about identity, but traffic IS encrypted.
# For no warning at all, put Caddy in front instead — see deploy/Caddyfile.
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Login throttle --------------------------------------------------------
# Failed attempts before an email, or an address, is made to wait.
AUTH_MAX_FAILURES_PER_EMAIL=5
AUTH_MAX_FAILURES_PER_IP=20
AUTH_LOCKOUT_MINUTES=15
